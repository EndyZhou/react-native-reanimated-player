{
  "name": "@endyzhou/react-native-reanimated-player",
  "version": "3.0.1",
  "description": "A react-native video player that interacts like Youtube player, built upon Reanimted v2 & react-native-gesture-handle",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-awesome-gallery.podspec",
    "!lib/typescript/example",
    "!android/build",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "prepare": "bob build",
    "release": "release-it",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "test": "jest",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn install"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "react-native-reanimted",
    "react-native-gesture-handle",
    "slider",
    "scrubber",
    "video",
    "control"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endyzhou/react-native-reanimated-player.git"
  },
  "author": "endyzhou (https://github.com/endyzhou)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/endyzhou/react-native-reanimated-player/issues"
  },
  "homepage": "https://github.com/endyzhou/react-native-reanimated-player",
  "dependencies": {
    "lodash.padstart": "^4.6.1",
    "react-native-video": ">=6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/runtime": "^7.21.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-navigation/core": "6.4.8",
    "@release-it/conventional-changelog": "^5.1.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-native": "^0.72.2",
    "@types/react-native-video": ">=6.0.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.57.1",
    "babel-jest": "^29.5.0",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "lottie-react-native": "7.3.4",
    "metro-react-native-babel-preset": "^0.76.1",
    "react-native": "0.81.5",
    "react-native-awesome-slider": "2.9.0",
    "react-native-builder-bob": "^0.40.17",
    "react-native-gesture-handler": "~2.30.0",
    "expo-screen-orientation": "9.0.8",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1",
    "react-native-safe-area-context": "^4.5.1",
    "react-test-renderer": "18.2.0",
    "release-it": "15.10.1",
    "typescript": "^5.0.4"
  },
  "peerDependencies": {
    "@react-navigation/core": "*",
    "lottie-react-native": ">=7.3.4",
    "react": "*",
    "react-native": "*",
    "react-native-awesome-slider": ">=2.0.0",
    "react-native-gesture-handler": ">=2.30.0",
    "expo-screen-orientation": "*",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": ">=0.5.1",
    "react-native-safe-area-context": "*",
    "react-native-video": ">=6.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
